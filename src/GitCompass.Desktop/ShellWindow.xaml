<Window x:Class="GitCompass.Desktop.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitCompass" Width="1200" Height="860" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ShellBackdropBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid x:Name="RootShell" Background="{DynamicResource ShellBackdropBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border x:Name="SidebarSurface" Padding="16,22,16,14" Panel.ZIndex="30">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="8,0,8,22">
          <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Image Source="/GitCompass;component/branding/GitCompass.ico" Width="30" Height="30" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="GitCompass" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Your project, step by step" Style="{StaticResource HelperText}" Margin="0,3,0,0" />
          </StackPanel>
          <Button x:Name="CloseNavigationButton" Grid.Column="2" Content="&#xE711;" FontFamily="Segoe Fluent Icons" Padding="8" Margin="8,0,0,0" Visibility="Collapsed" Click="CloseNavigationDrawer" AutomationProperties.Name="Close navigation" />
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
          <Grid>
            <TextBox x:Name="NavigationSearch" TextChanged="NavigationSearchChanged" Padding="36,8,10,8"
                     AutomationProperties.Name="Find a page" ToolTip="Search Home, Projects, Changed files, Saved versions, Sharing, Learn or Settings" />
            <TextBlock Text="&#xE721;" Style="{StaticResource FluentIcon}" FontSize="15" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
            <TextBlock Text="Find a page" Margin="36,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=NavigationSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <TextBlock x:Name="NavigationSearchSummary" Style="{StaticResource HelperText}" Margin="8,6,8,0" Visibility="Collapsed" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
          <TextBlock Text="CURRENT PROJECT" Style="{StaticResource HelperText}" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,8" />
          <Grid>
            <ComboBox x:Name="ProjectSelector" SelectionChanged="ProjectSelected" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Current project">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="174" ToolTip="{Binding Folder}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="ProjectPlaceholder" Text="Choose a project" IsHitTestVisible="False" Margin="12,0,28,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          </Grid>
          <Button Click="PickFolder" Margin="0,8,0,0" HorizontalContentAlignment="Left" AutomationProperties.Name="Choose a project folder">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource FluentIcon}" FontSize="16" Margin="0,0,10,0" /><TextBlock Text="Choose a project folder" VerticalAlignment="Center" /></StackPanel>
          </Button>
        </StackPanel>
        <ListBox x:Name="Navigation" Grid.Row="3" Background="Transparent" BorderThickness="0"
                 SelectionChanged="NavigationChanged" PreviewMouseLeftButtonUp="NavigationClicked" ItemContainerStyle="{StaticResource NavigationItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Main navigation">
          <ListBoxItem Tag="Overview" IsSelected="True" AutomationProperties.Name="Home">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource FluentIcon}" Width="30" /><TextBlock Text="Home" VerticalAlignment="Center" /></StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Projects" AutomationProperties.Name="Projects">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource FluentIcon}" Width="30" /><TextBlock Text="Projects" VerticalAlignment="Center" /></StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Changes" AutomationProperties.Name="Changed files">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource FluentIcon}" Width="30" /><TextBlock Text="Changed files" VerticalAlignment="Center" /></StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="History graph" AutomationProperties.Name="Saved versions">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource FluentIcon}" Width="30" /><TextBlock Text="Saved versions" VerticalAlignment="Center" /></StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Branches" AutomationProperties.Name="Branches">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AB;" Style="{StaticResource FluentIcon}" Width="30" /><TextBlock Text="Branches" VerticalAlignment="Center" /></StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Pull requests" AutomationProperties.Name="Sharing">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72D;" Style="{StaticResource FluentIcon}" Width="30" /><TextBlock Text="Sharing" VerticalAlignment="Center" /></StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Learn" AutomationProperties.Name="Learn">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE82D;" Style="{StaticResource FluentIcon}" Width="30" /><TextBlock Text="Learn" VerticalAlignment="Center" /></StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="Settings" AutomationProperties.Name="Settings">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource FluentIcon}" Width="30" /><TextBlock Text="Settings" VerticalAlignment="Center" /></StackPanel>
          </ListBoxItem>
        </ListBox>
        <StackPanel Grid.Row="4" Margin="8,14,8,0">
          <TextBlock Text="Local versions first. Share when ready." Style="{StaticResource HelperText}" />
          <Button x:Name="ActivityToggleButton" Click="ToggleActivityDock" Margin="0,12,0,0" HorizontalContentAlignment="Left" AutomationProperties.Name="Show activity and tools">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource FluentIcon}" FontSize="16" Margin="0,0,10,0" /><TextBlock Text="Activity and tools" /></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="MainWorkspace" Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition x:Name="PageRow" Height="*" MinHeight="160" />
        <RowDefinition Height="Auto" /><RowDefinition x:Name="DockRow" Height="0" MinHeight="0" />
      </Grid.RowDefinitions>
      <Border x:Name="PageHeader" Grid.Row="0" Padding="30,20,30,16">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="NavigationToggleButton" Content="&#xE700;" FontFamily="Segoe Fluent Icons" Padding="10,8" Margin="0,0,12,0" Visibility="Collapsed" Click="ToggleNavigationDrawer" AutomationProperties.Name="Open navigation" />
            <TextBlock x:Name="PageBreadcrumb" Grid.Column="1" Text="GitCompass  /  Home" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Button x:Name="CompactActivityToggleButton" Grid.Column="2" Content="Activity" Margin="12,0,0,0" Visibility="Collapsed" Click="ToggleActivityDock" AutomationProperties.Name="Show activity details" />
          </Grid>
          <Grid x:Name="HeaderContext" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel x:Name="ProjectSummary">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8AB;" Style="{StaticResource FluentIcon}" FontSize="15" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" />
                <TextBlock x:Name="BranchLabel" Grid.Column="1" Text="No project" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
              </Grid>
              <TextBlock x:Name="ProjectPath" Text="Choose any project folder to begin." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,20,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>
            <WrapPanel x:Name="HeaderActions" Grid.Column="1" VerticalAlignment="Top">
              <ComboBox x:Name="AccessSelector" Width="145" SelectionChanged="AccessChanged" AutomationProperties.Name="Project access mode" ToolTip="What GitCompass is allowed to do in this project" Margin="0,0,10,0">
                <ComboBoxItem Content="Read-only" ToolTip="GitCompass only looks. Nothing in your folder changes." AutomationProperties.HelpText="GitCompass only looks. Nothing in your folder changes." /><ComboBoxItem Content="Monitor only" ToolTip="GitCompass looks and can check the online copy for updates, but never changes your files." AutomationProperties.HelpText="GitCompass looks and can check the online copy for updates, but never changes your files." /><ComboBoxItem Content="Allow changes" ToolTip="GitCompass may save versions or upload, but only after you review each step." AutomationProperties.HelpText="GitCompass may save versions or upload, but only after you review each step." />
              </ComboBox>
              <Button x:Name="CheckRemoteButton" Content="Check team updates" ToolTip="Look at the online copy for new saved versions (fetch). Your files don't change." Click="CheckRemote" Margin="0" />
            </WrapPanel>
          </Grid>
          <Grid x:Name="HeaderStatus" Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Name="AccessHelper" Style="{StaticResource HelperText}" Margin="0,0,16,0" />
            <TextBlock x:Name="FreshnessLabel" Grid.Column="1" Text="Team updates not checked" Style="{StaticResource HelperText}" MaxWidth="215" TextAlignment="Right" />
          </Grid>
        </Grid>
      </Border>
      <Border x:Name="StatusBanner" Grid.Row="1" Background="{DynamicResource TintBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="30,0,30,8" Padding="16,12" Visibility="Collapsed">
        <ScrollViewer x:Name="StatusMessageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel><TextBlock x:Name="BannerText" /><Button x:Name="OpenAffectedProjectButton" Content="Open affected project" Click="OpenAffectedProject" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" /></StackPanel>
        </ScrollViewer>
      </Border>
      <Border Grid.Row="2">
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,8">
          <StackPanel x:Name="PageContent" Margin="30,6,30,24" MaxWidth="1060" HorizontalAlignment="Stretch" />
        </ScrollViewer>
      </Border>
      <!-- Keep tools in the visual tree; opening activity expands this row. -->
      <GridSplitter x:Name="DockSplitter" Grid.Row="3" Height="0" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Resize activity panel" />
      <Border x:Name="DockSurface" Grid.Row="4" ClipToBounds="True" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SurfaceBrush}">
        <TabControl x:Name="DockTabs" BorderThickness="0" Margin="10,0,10,10">
          <TabItem Header="Activity">
            <Grid Margin="8">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <WrapPanel x:Name="ActivityToolbar" Margin="0,0,0,8">
                <ComboBox x:Name="OutputChannel" Width="175" SelectionChanged="OutputFilterChanged" AutomationProperties.Name="Output channel">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" MaxWidth="210" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox x:Name="OutputSearch" Width="105" Margin="8,0" TextChanged="OutputFilterChanged" ToolTip="Search retained activity" AutomationProperties.Name="Search output" />
                <ComboBox x:Name="OutputSeverity" Width="120" Margin="0,0,8,0" SelectionChanged="OutputFilterChanged" SelectedIndex="0" AutomationProperties.Name="Output state filter">
                  <ComboBoxItem Content="All states" /><ComboBoxItem Content="Problems" /><ComboBoxItem Content="Succeeded" /><ComboBoxItem Content="In progress" />
                </ComboBox>
                <CheckBox x:Name="AutoScroll" Content="Auto-scroll" IsChecked="True" VerticalAlignment="Center" />
                <CheckBox x:Name="GroupOutput" Content="Group by operation" IsChecked="True" Checked="OutputGroupingChanged" Unchecked="OutputGroupingChanged" VerticalAlignment="Center" Margin="10,0" />
                <Button x:Name="CopyActivityButton" Content="Copy" Click="CopyOutput" /><Button x:Name="ClearActivityButton" Content="Clear view" Click="ClearOutput" />
                <Button x:Name="ActivityOptionsButton" Content="More" Click="ShowActivityOptions" AutomationProperties.Name="More activity options">
                  <Button.ContextMenu><ContextMenu>
                    <MenuItem Header="Copy activity" Click="CopyOutput" /><MenuItem Header="Clear view" Click="ClearOutput" />
                    <Separator />
                    <MenuItem Header="Auto-scroll" IsCheckable="True" Click="ToggleActivityAutoScroll" />
                    <MenuItem Header="Group by operation" IsCheckable="True" Click="ToggleActivityGrouping" />
                    <Separator /><MenuItem Header="Prepare support view" Click="PrepareSupport" />
                  </ContextMenu></Button.ContextMenu>
                </Button>
              </WrapPanel>
              <TextBox Grid.Row="1" x:Name="OutputText" Visibility="Collapsed" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" AutomationProperties.Name="App-managed operation output" />
              <ScrollViewer Grid.Row="1" x:Name="OutputGroupsScroll" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="OutputGroups" /></ScrollViewer>
            </Grid>
          </TabItem>
          <TabItem Header="Problems"><ScrollViewer><StackPanel x:Name="ProblemsPanel" Margin="16" /></ScrollViewer></TabItem>
          <TabItem Header="Terminal">
            <Grid Margin="8">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <WrapPanel x:Name="TerminalToolbar" Margin="0,0,0,8">
                <Button x:Name="NewTerminalButton" Content="New PowerShell session" Click="NewTerminal" IsEnabled="False" />
                <Button x:Name="InterruptTerminalButton" Content="Interrupt" Click="InterruptTerminal" /><Button x:Name="CopyTerminalButton" Content="Copy selection" Click="CopyTerminal" /><Button x:Name="PasteTerminalButton" Content="Paste" Click="PasteTerminal" /><Button x:Name="CloseTerminalButton" Content="Close session" Click="CloseTerminal" />
                <Button x:Name="TerminalOptionsButton" Content="More" Click="ShowTerminalOptions" Visibility="Collapsed" AutomationProperties.Name="More terminal options">
                  <Button.ContextMenu><ContextMenu>
                    <MenuItem Header="Interrupt" Click="InterruptTerminal" /><MenuItem Header="Copy selection" Click="CopyTerminal" />
                    <MenuItem Header="Paste" Click="PasteTerminal" /><MenuItem Header="Close session" Click="CloseTerminal" />
                  </ContextMenu></Button.ContextMenu>
                </Button>
                <TextBlock x:Name="TerminalModeText" Text="To type commands here, first choose Allow changes at the top." VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
              </WrapPanel>
              <TabControl Grid.Row="1" x:Name="TerminalTabs" />
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
    <Border x:Name="SidebarScrim" Grid.ColumnSpan="2" Panel.ZIndex="20" Background="#66000000" Visibility="Collapsed" MouseLeftButtonDown="CloseNavigationDrawer" AutomationProperties.Name="Close navigation overlay" />
  </Grid>
</Window>
