<Window x:Class="GitCompass.Desktop.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GitCompass" Width="1440" Height="960" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Background="{DynamicResource WindowBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14,20">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="8,0,0,24"><TextBlock Text="◈  GitCompass" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Understand your next step" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" FontSize="12"/></StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="Your project. Clear direction." FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="8,10,0,4"/>
    <ListBox x:Name="Navigation" Background="Transparent" BorderThickness="0" SelectionChanged="NavigationChanged" AutomationProperties.Name="Main navigation">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="12,14"/><Setter Property="Margin" Value="0,3,0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
     <ListBoxItem Content="⌂   Overview" Tag="Overview" IsSelected="True"/><ListBoxItem Content="▤   Changes" Tag="Changes"/><ListBoxItem Content="⑂   History graph" Tag="History graph"/><ListBoxItem Content="⑂   Branches" Tag="Branches"/><ListBoxItem Content="⇄   Pull requests" Tag="Pull requests"/><ListBoxItem Content="▱   Learn" Tag="Learn"/><ListBoxItem Content="⚙   Settings" Tag="Settings"/>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="160"/><RowDefinition Height="6"/><RowDefinition x:Name="DockRow" Height="220" MinHeight="80"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><WrapPanel VerticalAlignment="Center"><Grid><ComboBox x:Name="ProjectSelector" MinWidth="205" MaxWidth="300" SelectionChanged="ProjectSelected" DisplayMemberPath="DisplayName" AutomationProperties.Name="Current project"/><TextBlock x:Name="ProjectPlaceholder" Text="No project selected" IsHitTestVisible="False" Margin="10,0,24,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/></Grid><Button Content="Select folder" Click="PickFolder" Margin="10,0,18,0"/><TextBlock Text="Branch " VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="BranchLabel" Text="No project" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/><TextBlock Text="Access " VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><ComboBox x:Name="AccessSelector" Width="150" SelectionChanged="AccessChanged" AutomationProperties.Name="Project access mode"><ComboBoxItem Content="Read-only"/><ComboBoxItem Content="Monitor only"/><ComboBoxItem Content="Allow changes"/></ComboBox></WrapPanel><TextBlock x:Name="ProjectPath" Text="Select a project folder to begin." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="AccessHelper" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="15,0,0,0"><Button x:Name="CheckRemoteButton" Content="Check remote" Click="CheckRemote"/><TextBlock x:Name="FreshnessLabel" Text="Remote not checked" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,9,8,0" HorizontalAlignment="Right"/></StackPanel>
    </Grid>
   </Border>
   <Border x:Name="StatusBanner" Grid.Row="1" Background="{DynamicResource TintBrush}" Padding="24,9" Visibility="Collapsed"><StackPanel><TextBlock x:Name="BannerText"/><Button x:Name="OpenAffectedProjectButton" Content="Open affected project" Click="OpenAffectedProject" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed"/></StackPanel></Border>
   <Border Grid.Row="2" Background="{DynamicResource WindowBrush}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PageContent" Margin="28,24,28,24"/></ScrollViewer></Border>
   <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="Resize output dock"/>
   <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SurfaceBrush}">
    <TabControl x:Name="DockTabs" BorderThickness="0" Margin="10,0,10,10">
     <TabItem Header="Git Output"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,8"><ComboBox x:Name="OutputChannel" Width="190" SelectionChanged="OutputFilterChanged" AutomationProperties.Name="Output channel"/><TextBlock Text="Filter output" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox x:Name="OutputSearch" Width="110" Margin="8,0" TextChanged="OutputFilterChanged" ToolTip="Search retained output" AutomationProperties.Name="Search output"/><ComboBox x:Name="OutputSeverity" Width="115" Margin="0,0,8,0" SelectionChanged="OutputFilterChanged" SelectedIndex="0" AutomationProperties.Name="Output state filter"><ComboBoxItem Content="All states"/><ComboBoxItem Content="Problems"/><ComboBoxItem Content="Succeeded"/><ComboBoxItem Content="In progress"/></ComboBox><CheckBox x:Name="AutoScroll" Content="Auto-scroll" IsChecked="True" VerticalAlignment="Center"/><CheckBox x:Name="GroupOutput" Content="Group by operation" IsChecked="True" Checked="OutputGroupingChanged" Unchecked="OutputGroupingChanged" VerticalAlignment="Center" Margin="10,0"/><Button Content="Copy" Click="CopyOutput"/><Button Content="Clear view" Click="ClearOutput"/><Button Content="Prepare support view" Click="PrepareSupport"/></WrapPanel><TextBox Grid.Row="1" x:Name="OutputText" Visibility="Collapsed" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" AutomationProperties.Name="App-managed operation output"/><ScrollViewer Grid.Row="1" x:Name="OutputGroupsScroll" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="OutputGroups"/></ScrollViewer></Grid></TabItem>
     <TabItem Header="Problems"><ScrollViewer><StackPanel x:Name="ProblemsPanel" Margin="16"/></ScrollViewer></TabItem>
     <TabItem Header="Terminal"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,8"><Button x:Name="NewTerminalButton" Content="New PowerShell session" Click="NewTerminal" IsEnabled="False"/><Button Content="Interrupt" Click="InterruptTerminal"/><Button Content="Copy selection" Click="CopyTerminal"/><Button Content="Paste" Click="PasteTerminal"/><Button Content="Close session" Click="CloseTerminal"/><TextBlock x:Name="TerminalModeText" Text="Allow changes is required for an interactive terminal." VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/></WrapPanel><TabControl Grid.Row="1" x:Name="TerminalTabs"/></Grid></TabItem>
    </TabControl>
   </Border>
  </Grid>
 </Grid>
</Window>
