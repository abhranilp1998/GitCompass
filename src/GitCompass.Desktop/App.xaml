<Application x:Class="GitCompass.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GitCompass.Desktop"
             ThemeMode="System">
  <Application.Resources>
    <!-- Native Fluent templates retain keyboard, focus, disabled and popup behavior. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="ShellBackdropBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#5F5F5F" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="TintBrush" Color="#EAF3FB" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
    <DataTemplate x:Key="WrappedButtonText"><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
    <local:StringContentTemplateSelector x:Key="ButtonContentSelector" StringTemplate="{StaticResource WrappedButtonText}" />

    <Style TargetType="Window" BasedOn="{StaticResource DefaultWindowStyle}">
      <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="HelperText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="18" />
    </Style>
    <Style x:Key="PageGroupTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,22,0,10" />
    </Style>
    <Style x:Key="FluentIcon" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="18" /><Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="SettingsCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="20,16" /><Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <!-- Set spacing and colors without replacing native control templates. -->
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
      <Setter Property="ContentTemplateSelector" Value="{StaticResource ButtonContentSelector}" />
      <Setter Property="Padding" Value="14,8" /><Setter Property="MinHeight" Value="36" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>
    <!-- Pill-shaped documentation link: themed, hover/pressed states, visible keyboard focus ring. -->
    <Style x:Key="LinkChip" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource TintBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="12,4" /><Setter Property="Margin" Value="0,4,8,8" />
      <Setter Property="FontSize" Value="13" /><Setter Property="Cursor" Value="Hand" /><Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Pill" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <TextBlock x:Name="Label" Text="{TemplateBinding Content}" TextWrapping="NoWrap" TextDecorations="None" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Label" Property="TextDecorations" Value="Underline" /><Setter TargetName="Pill" Property="Background" Value="{DynamicResource SurfaceBrush}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pill" Property="BorderThickness" Value="2" /><Setter TargetName="Label" Property="TextDecorations" Value="Underline" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Pill" Property="Opacity" Value="0.8" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
      <Setter Property="ContentTemplateSelector" Value="{StaticResource ButtonContentSelector}" />
      <Setter Property="Padding" Value="14,8" /><Setter Property="MinHeight" Value="36" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
      <Setter Property="Padding" Value="10,8" /><Setter Property="MinHeight" Value="36" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
      <Setter Property="Padding" Value="10,8" /><Setter Property="MinHeight" Value="36" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="MaxDropDownHeight" Value="320" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}"><Setter Property="Padding" Value="10,8" /></Style>
    <Style TargetType="ListBox" BasedOn="{StaticResource DefaultListBoxStyle}">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
      <Setter Property="Padding" Value="8" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="NavigationItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="Padding" Value="12,10" /><Setter Property="MinHeight" Value="42" />
      <Setter Property="Margin" Value="0,2,0,2" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Border.CornerRadius" Value="4" />
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource TintBrush}" /></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TabControl" BasedOn="{StaticResource DefaultTabControlStyle}">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style TargetType="TabItem" BasedOn="{StaticResource DefaultTabItemStyle}"><Setter Property="Padding" Value="14,9" /></Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Margin" Value="0,6,0,6" /><Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="Expander" BasedOn="{StaticResource DefaultExpanderStyle}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Margin" Value="0,8,0,8" />
    </Style>
  </Application.Resources>
</Application>
